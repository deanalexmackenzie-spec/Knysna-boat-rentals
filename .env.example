# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. SERVER ONLY — never expose to the browser, never prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── PayFast ─────────────────────────────────────────────────────────────────
# Leave ALL of the PAYFAST_* variables unset to run EFT-only; card payments are
# then switched off and the booking page offers bank transfer alone.
#
# To enable card payments, set every one of them. There is no default: a
# missing or mistyped value fails at startup rather than quietly falling back
# to sandbox, where a checkout looks normal and collects nothing.
#
# Sandbox merchant credentials are published at https://sandbox.payfast.co.za
# under "Sandbox Credentials" — paste them here for testing. Live credentials
# come from the PayFast dashboard.
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
# Passphrase set under PayFast → Settings → Security. Leave blank if none is set.
PAYFAST_PASSPHRASE=
# "sandbox" or "live" (case-insensitive). Any other value is rejected outright.
PAYFAST_MODE=sandbox
# Production builds refuse to run in sandbox mode. Set this to "true" only for a
# deliberate staging deployment that should not take real money.
# PAYFAST_ALLOW_SANDBOX=true

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key
EMAIL_FROM="Knysna Boat Rentals <bookings@yourdomain.co.za>"
# Owner notification inbox for new booking requests
OWNER_EMAIL=owner@yourdomain.co.za

# ─── Cron ────────────────────────────────────────────────────────────────────
# Shared secret required by /api/cron/reminders (Authorization: Bearer <secret>)
CRON_SECRET=generate-a-long-random-string
